<resources>

    <!-- Tema OSCURO -->
    <style name="Theme.AsistenciaQR.Dark" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/cyan</item>
        <item name="colorOnPrimary">@color/dark_bg</item>
        <item name="colorSecondary">@color/purple</item>
        <item name="colorTertiary">@color/green</item>
        <item name="colorSurface">@color/dark_surface</item>
        <item name="colorOnSurface">@color/text_primary_dark</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary_dark</item>
        <item name="colorError">@color/red</item>
        <item name="android:windowBackground">@color/dark_bg</item>
        <item name="android:statusBarColor">@color/dark_bg</item>
        <item name="android:navigationBarColor">@color/dark_surface</item>
    </style>

    <!-- Tema CLARO -->
    <style name="Theme.AsistenciaQR.Light" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/purple</item>
        <item name="colorOnPrimary">@color/light_surface</item>
        <item name="colorSecondary">@color/cyan</item>
        <item name="colorTertiary">@color/green</item>
        <item name="colorSurface">@color/light_surface</item>
        <item name="colorOnSurface">@color/text_primary_light</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary_light</item>
        <item name="colorError">@color/red</item>
        <item name="android:windowBackground">@color/light_bg</item>
        <item name="android:statusBarColor">@color/light_bg</item>
        <item name="android:navigationBarColor">@color/light_surface</item>
    </style>

</resources>