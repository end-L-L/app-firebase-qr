<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NUEVA SESIÓN"
            android:textColor="?attr/colorPrimary"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.15"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Configura los datos de la clase"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="13sp"
            android:layout_marginBottom="24dp" />

        <!-- Nombre de la materia -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_materia"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nombre de la materia"
            android:layout_marginBottom="16dp"
            app:boxStrokeColor="?attr/colorPrimary"
            app:hintTextColor="?attr/colorOnSurfaceVariant">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_materia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapWords"
                android:textColor="?attr/colorOnSurface" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Grupo -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_grupo"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Grupo (ej. 3A, 5B)"
            android:layout_marginBottom="16dp"
            app:boxStrokeColor="?attr/colorPrimary"
            app:hintTextColor="?attr/colorOnSurfaceVariant">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_grupo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapCharacters"
                android:textColor="?attr/colorOnSurface" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Duración del QR -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Duración del código QR"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="12sp"
            android:layout_marginBottom="10dp" />

        <com.google.android.material.slider.Slider
            android:id="@+id/slider_duracion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:valueFrom="5"
            android:valueTo="30"
            android:stepSize="5"
            android:value="15"
            android:layout_marginBottom="4dp"
            app:thumbColor="?attr/colorPrimary"
            app:trackColorActive="?attr/colorPrimary" />

        <TextView
            android:id="@+id/tv_duracion_valor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="15 minutos"
            android:textColor="?attr/colorPrimary"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="32dp" />

        <!-- ProgressBar -->
        <ProgressBar
            android:id="@+id/progress_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:visibility="gone"
            android:layout_marginBottom="12dp" />

        <!-- Botón Generar QR -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_generar_qr"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Generar código QR"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            app:backgroundTint="?attr/colorPrimary"
            android:textColor="?attr/colorOnPrimary" />

    </LinearLayout>
</ScrollView>